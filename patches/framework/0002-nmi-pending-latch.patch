From 77f1e9df1f4e4f8b8f1c311ec7d260fde07ca3ee Mon Sep 17 00:00:00 2001
From: Tom McDonald <214910594+tamcdonald42@users.noreply.github.com>
Date: Tue, 24 Nov 2026 14:15:32 +0000
Subject: [PATCH] snes: keep the NMI-pending latch for a main-loop $4210 poll

A read taken while the NMI is being serviced acknowledges the interrupt but
no longer consumes rdnmiPending, and the field wrap no longer clears it.

A beam host delivers the NMI on reaching v=225, so the handler's own ack read
always ran before the game's main loop could poll $4210. Every poll in the
frame then saw pend=0 and Final Fantasy VI spun forever at 'lda hRDNMI / bpl'
once its intro ended (frame 5080 onward, screen permanently blank).

Verified against bsnes accuracy: WRAM at frame 5200 went from 13006 bytes
apart and frozen to 80, with identical event state, and a cold boot now plays
the intro, the title and the opening Narshe mission.
---
 runner/src/snes/snes.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/runner/src/snes/snes.c b/runner/src/snes/snes.c
index 5e4613de..d8a86588 100644
--- a/runner/src/snes/snes.c
+++ b/runner/src/snes/snes.c
@@ -464,7 +464,12 @@ static uint32_t snes_advance_beam(Snes *snes, uint32_t clocks, bool check_irq) {
         if (h >= 1364u) {
           h = 0; v++; if (v >= 262u) v = 0;
           if (v == 225u) { snes->rdnmiPending = true; ppu_rasterFieldBoundary(); }
-          if (v == 0u) snes->rdnmiPending = false;
+          /* The NMI-pending latch is cleared by the CPU's $4210 read, not by
+           * the field wrap. A beam host delivers the NMI on reaching v=225,
+           * so clearing here (or letting the handler's own ack read clear it,
+           * below) leaves the main loop's "lda hRDNMI / bpl" poll spinning on
+           * a latch that was consumed before it could look. Final Fantasy VI
+           * deadlocked exactly that way at the end of its intro. */
         }
         snes->hPos = (uint16_t)h;
         snes->vPos = (uint16_t)v;
@@ -633,8 +638,11 @@ uint8_t snes_readReg(Snes* snes, uint16_t adr) {
       // before the next NMI fires. (SMW happens to discard the loaded
       // value, but a hardware-correct read-clear costs one store and
       // is the right contract for game #2.)
+      // The one exception is the read the handler itself takes to
+      // acknowledge the interrupt: that acks, but must leave the pending
+      // latch for a main-loop poll later in the same frame.
+      if (!snes->inNmi) snes->rdnmiPending = false;
       snes->inNmi = false;
-      snes->rdnmiPending = false;
       return val;
     }
     case 0x4211: {
