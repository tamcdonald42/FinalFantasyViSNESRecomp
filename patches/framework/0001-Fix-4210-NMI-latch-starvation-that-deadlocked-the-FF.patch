 runner/src/common_rtl.c         | 29 ++++++++++-
 runner/src/common_rtl.h         |  1 +
 runner/src/snes/apu.c           | 55 ++++++++++++++++++++
 runner/src/snes/interp_bridge.c | 14 +++--
 runner/src/snes/snes.c          | 39 ++++++++++++--
 runner/src/state_dump.c         | 91 ++++++++++++++++++++++++++++++++-
 7 files changed, 231 insertions(+), 10 deletions(-)

diff --git a/runner/src/beam_frame_driver.c b/runner/src/beam_frame_driver.c
index d6086b35..7cc41792 100644
--- a/runner/src/beam_frame_driver.c
+++ b/runner/src/beam_frame_driver.c
@@ -150,6 +150,18 @@ void snes_beam_frame_driver_run_frame(void) {
   if (!booting && g_snes->nmiEnabled) {
     g_snes->inNmi = true;
     s_wai_halted = false;
+    {
+      extern int snes_frame_counter;
+      static int logged;
+      if (snes_frame_counter >= 5000 && logged < 200) {
+        logged++;
+        fprintf(stderr, "[nmi] f=%d vec=%06X hook=%02X%02X%02X%02X f17=%02X inidisp=%02X\n",
+                snes_frame_counter, (unsigned)nmi_vector(),
+                (unsigned)g_ram[0x1500], (unsigned)g_ram[0x1501],
+                (unsigned)g_ram[0x1502], (unsigned)g_ram[0x1503],
+                (unsigned)g_ram[0x17], (unsigned)g_ppu->inidisp);
+      }
+    }
     run_interrupt(nmi_vector(), frame_end);
     g_snes->inNmi = false;
   }
diff --git a/runner/src/common_rtl.c b/runner/src/common_rtl.c
index 0053b4fd..a62ae55f 100644
--- a/runner/src/common_rtl.c
+++ b/runner/src/common_rtl.c
@@ -303,6 +303,10 @@ static uint64_t rtl_apu_guest_cycle(void) {
          within * RTL_APU_CYCLES_PER_FRAME /
              RTL_MASTER_CYCLES_PER_FRAME;
 }
+
+/* Non-static mirror for state_dump diagnostics. */
+uint64_t RtlApuGuestCyclePub(void) { return rtl_apu_guest_cycle(); }
+
 // $420D bit 0 (FastROM / MEMSEL): 1 => $80-$FF:$8000-$FFFF code runs fast (6
 // master clocks/access) instead of slow (8). Tracked here so emitted blocks in
 // the WS2 mirror banks weight their master-cycle charge correctly at runtime.
@@ -1844,6 +1848,12 @@ uint16 ReadRegWord(uint16 reg) {
     extern Snes *g_snes;
     RtlApuLock();
     rtl_sync_apu_to_cpu_locked();
+    { extern int snes_frame_counter; static int n;
+      if (snes_frame_counter >= 5080 && n++ < 400)
+        fprintf(stderr, "[rdw] f=%d reg=%04X out0=%02X out1=%02X clock=%llu\n",
+                snes_frame_counter, (unsigned)reg,
+                (unsigned)g_snes->apu->outPorts[0], (unsigned)g_snes->apu->outPorts[1],
+                (unsigned long long)g_snes->apu->portClock); }
     uint8_t lo = g_snes->apu->outPorts[(reg & 0x3)];
     uint8_t hi = g_snes->apu->outPorts[((reg + 1) & 0x3)];
     RtlApuUnlock();
@@ -2045,10 +2055,27 @@ void rtl_accumulate_apu_catchup(void) {
 uint64_t apuw_prof_calls = 0;
 double apuw_prof_ms = 0.0;
 #endif
+static void apuw_diag(uint16 adr, uint8 val, const char *why) {
+  extern int snes_frame_counter;
+  static int n_scope, n_ok;
+  int f = snes_frame_counter;
+  if (f < 5070) return;
+  if (why[0] == 'S') {
+    if (n_scope++ < 150)
+      fprintf(stderr, "[apuw] f=%d SCOPE-DROP#%d adr=%04X val=%02X\n", f, n_scope,
+              (unsigned)adr, (unsigned)val);
+  } else {
+    if ((adr & 3) == 0 && n_ok++ < 120)
+      fprintf(stderr, "[apuw] f=%d DELIVER#%d adr=%04X val=%02X\n", f, n_ok,
+              (unsigned)adr, (unsigned)val);
+  }
+}
+
 void RtlApuWrite(uint16 adr, uint8 val) {
-  if (s_guest_scope_active) return;
+  if (s_guest_scope_active) { apuw_diag(adr, val, "SCOPE"); return; }
   assert(adr >= 0x2140 && adr <= 0x217f);
   if (rtl_apu_port_observers_filter(adr, val)) return;
+  apuw_diag(adr, val, "OK");
   uint8_t port = (uint8_t)(adr & 3);
 #ifdef SNESRECOMP_INTERP_PROFILE
   { extern uint64_t apuw_prof_calls; extern double apuw_prof_ms;
